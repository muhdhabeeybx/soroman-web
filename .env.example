VITE_SERVER_URL=http://localhost:5002
# Cooking gas cylinder delivery. Leave unset or "false" for Coming soon —
# no wizard, dashboard, or LPG API calls. Set "true" to re-enable.
VITE_COOKING_GAS_ENABLED=false

